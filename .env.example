# ==========================================
# WellNexa AI Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME="WellNexa AI"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production_min_32_chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173","http://localhost:8000","*"]

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wellnexa
POSTGRES_PASSWORD=wellnexa_secure_password
POSTGRES_DB=wellnexa_db
DATABASE_URL=postgresql+asyncpg://wellnexa:wellnexa_secure_password@localhost:5432/wellnexa_db
SYNC_DATABASE_URL=postgresql://wellnexa:wellnexa_secure_password@localhost:5432/wellnexa_db

# Security & JWT Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
STORAGE_BACKEND=local
UPLOAD_DIR=/home/ajay-chaudhari/Desktop/wellnexa/storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB

# AI & LLM Providers (OpenAI / Google Gemini / Ollama / Mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# OCR Engine (paddleocr / tesseract / mock)
OCR_ENGINE=paddleocr
