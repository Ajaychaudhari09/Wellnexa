# Copy to .env and replace all CHANGE_ME values before startup.
ENVIRONMENT=development
DEBUG=false
APP_NAME=WellNexa AI
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL with pgvector (Docker Compose uses the values below)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wellnexa
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=wellnexa_db
DATABASE_URL=postgresql+asyncpg://wellnexa:CHANGE_ME_database_password@localhost:5432/wellnexa_db
SYNC_DATABASE_URL=postgresql://wellnexa:CHANGE_ME_database_password@localhost:5432/wellnexa_db

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
OCR_ENGINE=tesseract

# OpenAI official SDK; real AI features require a valid key and model access.
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# SMTP aliases accepted: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM.
# Port 587 uses STARTTLS even when EMAIL_SECURE=false (no implicit TLS).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=CHANGE_ME
EMAIL_PASS=CHANGE_ME
EMAIL_FROM_NAME=WellNexa
EMAIL_FROM_ADDRESS=CHANGE_ME
SUPPORT_EMAIL=CHANGE_ME
