import sys
try:
    from pptx import Presentation
    from pptx.util import Inches, Pt
    from pptx.dml.color import RGBColor
    from pptx.enum.text import PP_ALIGN
    from pptx.enum.shapes import MSO_SHAPE
except Exception as e:
    print(e); sys.exit(1)

NAVY = RGBColor(0x0F,0x2B,0x5B)
TEAL = RGBColor(0x00,0x8B,0x8B)
GREY = RGBColor(0x44,0x44,0x44)
WHITE = RGBColor(0xFF,0xFF,0xFF)

prs = Presentation()
prs.slide_width = Inches(13.333)
prs.slide_height = Inches(7.5)

def title_slide(title, subtitle):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    bg = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(0), Inches(13.333), Inches(7.5))
    bg.fill.solid(); bg.fill.fore_color.rgb = NAVY; bg.line.fill.background()
    t = slide.shapes.add_textbox(Inches(0.8), Inches(2.2), Inches(11.7), Inches(1.5))
    p = t.text_frame.paragraphs[0]; r = p.add_run(); r.text = title; r.font.size = Pt(44); r.font.bold = True; r.font.color.rgb = WHITE
    p.alignment = PP_ALIGN.CENTER
    t2 = slide.shapes.add_textbox(Inches(0.8), Inches(3.9), Inches(11.7), Inches(1.2))
    p2 = t2.text_frame.paragraphs[0]; r2 = p2.add_run(); r2.text = subtitle; r2.font.size = Pt(20); r2.font.color.rgb = RGBColor(0xBB,0xDD,0xEE)
    p2.alignment = PP_ALIGN.CENTER
    return slide

def heading_slide(title):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    bar = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(0), Inches(13.333), Inches(1.1))
    bar.fill.solid(); bar.fill.fore_color.rgb = TEAL; bar.line.fill.background()
    t = slide.shapes.add_textbox(Inches(0.6), Inches(0.15), Inches(12.1), Inches(0.8))
    p = t.text_frame.paragraphs[0]; r = p.add_run(); r.text = title; r.font.size = Pt(30); r.font.bold = True; r.font.color.rgb = WHITE
    return slide

def bullet_slide(title, bullets, font_size=20):
    slide = heading_slide(title)
    tb = slide.shapes.add_textbox(Inches(0.8), Inches(1.4), Inches(11.7), Inches(5.8))
    tf = tb.text_frame; tf.word_wrap = True
    for i, b in enumerate(bullets):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.text = b
        p.font.size = Pt(font_size)
        p.font.color.rgb = GREY
        p.space_after = Pt(8)
        p.level = 0
    return slide

def table_slide(title, headers, rows, col_widths=None):
    slide = heading_slide(title)
    n = len(headers)
    m = len(rows)
    table = slide.shapes.add_table(m+1, n, Inches(0.8), Inches(1.5), Inches(11.7), Inches(0.45*(m+1))).table
    for j, h in enumerate(headers):
        cell = table.cell(0, j)
        cell.text = h
        for p in cell.text_frame.paragraphs:
            for r in p.runs:
                r.font.bold = True; r.font.size = Pt(15); r.font.color.rgb = WHITE
        cell.fill.solid(); cell.fill.fore_color.rgb = TEAL
    for i, row in enumerate(rows):
        for j, val in enumerate(row):
            cell = table.cell(i+1, j)
            cell.text = str(val)
            for p in cell.text_frame.paragraphs:
                for r in p.runs:
                    r.font.size = Pt(13); r.font.color.rgb = GREY
    if col_widths:
        for j, w in enumerate(col_widths):
            for i in range(m+1):
                table.cell(i, j).width = Inches(w)
    return slide

# 1 Title
title_slide("WellNexa AI", "An AI-Powered Integrated Personal Healthcare & Wellness Management Platform\nCapstone Project Presentation — MCA Semester I, GLS University (2026-27)")

