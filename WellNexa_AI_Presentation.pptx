# 9 Architecture Diagram
slide = heading_slide("Architecture Diagram")
# draw layers
layers = [
    ("User Application (Browser / Mobile)", TEAL),
    ("Frontend — Next.js (React)", RGBColor(0x1F,0x6F,0x8B)),
    ("Backend API & Authentication — FastAPI (JWT, RBAC)", RGBColor(0x2E,0x5C,0x8A)),
    ("Health Records • Reports • Medicines • Nutrition • Fitness • Wellness • Appointments • Notifications", RGBColor(0x4A,0x6F,0xA5)),
    ("AI Engine — OCR • NLP • RAG (pgvector) • LLM • scikit-learn • Analytics", RGBColor(0x6B,0x5B,0x95)),
    ("Secure Database (PostgreSQL + pgvector) + Document Storage", RGBColor(0x8A,0x4A,0x6F)),
    ("Doctor / Healthcare Professional Portal", RGBColor(0x0F,0x2B,0x5B)),
]
y = 1.4
for label, color in layers:
    sh = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(2.2), Inches(y), Inches(8.9), Inches(0.7))
    sh.fill.solid(); sh.fill.fore_color.rgb = color; sh.line.fill.background()
    t = slide.shapes.add_textbox(Inches(2.2), Inches(y+0.12), Inches(8.9), Inches(0.5))
    p = t.text_frame.paragraphs[0]; r = p.add_run(); r.text = label; r.font.size = Pt(15); r.font.bold = True; r.font.color.rgb = WHITE
    p.alignment = PP_ALIGN.CENTER
    if y > 1.4:
        # arrow
        arr = slide.shapes.add_shape(MSO_SHAPE.DOWN_ARROW, Inches(6.3), Inches(y-0.32), Inches(0.7), Inches(0.32))
        arr.fill.solid(); arr.fill.fore_color.rgb = GREY; arr.line.fill.background()
    y += 0.95

