{
  "info": {
    "name": "WellNexa AI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@wellnexa.ai\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Demo Patient\",\n  \"role\": \"patient\"\n}" },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@wellnexa.ai\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/profile/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"age\": 30,\n  \"height_cm\": 170,\n  \"weight_kg\": 70,\n  \"blood_pressure\": \"120/80\",\n  \"glucose\": 95,\n  \"allergies\": \"None\",\n  \"lifestyle\": \"Active\",\n  \"goals\": \"Maintain weight\"\n}" },
            "url": "{{base_url}}/api/v1/profile/me"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Upload Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{base_url}}/api/v1/documents/upload"
          }
        },
        {
          "name": "List Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/reports"
          }
        }
      ]
    },
    {
      "name": "Reminders",
      "item": [
        {
          "name": "Create Reminder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Take medicine\",\n  \"category\": \"MEDICINE\",\n  \"due_at\": \"2026-10-27T09:00:00\",\n  \"notes\": \"After breakfast\"\n}" },
            "url": "{{base_url}}/api/v1/reminders"
          }
        },
        {
          "name": "List Reminders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/reminders"
          }
        }
      ]
    },
    {
      "name": "Doctor Sharing",
      "item": [
        {
          "name": "Grant Access",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"doctor_email\": \"doctor@wellnexa.ai\",\n  \"scope\": [\"reports\", \"profile\"],\n  \"expires_in_days\": 7\n}" },
            "url": "{{base_url}}/api/v1/sharing/grants"
          }
        },
        {
          "name": "Revoke Access",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/sharing/grants/1/revoke"
          }
        }
      ]
    }
  ]
}
